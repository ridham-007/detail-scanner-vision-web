{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/quizzes",
      "destination": "/quiz/",
      "statusCode": 301
    },
    {
      "source": "/quizzes/",
      "destination": "/quiz/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
